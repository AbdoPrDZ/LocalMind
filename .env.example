DATABASE_URL=sqlite:///./resources/data/app.db
MODELS_DIR=./resources/models
MODEL_NAME=qwen3-4b-instruct-gguf
MODEL_CONTEXT_WINDOW=4096
MODEL_CPU_THREADS=8
MODEL_GPU_LAYERS=0
MODEL_VERBOSE=false

# LLM backend: local (llama-cpp) | gemini (online) | openai (free routers + Gemini via one interface)
LLM_PROVIDER=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# OpenAI-compatible provider (LLM_PROVIDER=openai):
# - free models: route via the default free router (OpenRouter) with OPENAI_API_KEY
#   (or OPENROUTER_API_KEY). See resources/models/free_models.json for model ids.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openrouter/free
# - Gemini models through the same provider (model id starting with "gemini-"):
GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Keyless hosted LLM (LLM_PROVIDER=free): no API key at all.
# FREE_ENDPOINT picks a public anonymous endpoint from resources/models/keyless_models.json
# FREE_MODEL picks the model there; FREE_BASE_URL (optional) overrides the endpoint.
# Keyless tiers sometimes answer with injected ad/budget notices; the free
# provider retries once and then surfaces a clear error instead of showing them.
FREE_ENDPOINT=pollinations
FREE_MODEL=openai-fast

SYSTEM_PROMPT_PATH=./resources/SYSTEM_PROMPT.md

# New tool capabilities:
# Comma-separated "name=path" folders the file/command tools may use.
# Defaults to a single "workspace=./workspace" folder.
ALLOWED_PLACES=workspace=./workspace
# Set to 1 to let the model propose shell commands (each still needs your approval).
ENABLE_SHELL_TOOLS=0
# Web search backend (currently: bing — keyless RSS).
WEB_SEARCH_PROVIDER=bing
# Automatically turn durable tool findings (fetched pages, search results,
# read files, user answers) into low-importance global facts. 1 = on, 0 = off.
AUTO_MEMORIZE=1