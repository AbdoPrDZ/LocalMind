# ------------------------------------------------------------------
# LocalMind configuration
# ------------------------------------------------------------------

# SQLAlchemy database URL (SQLite by default).
DATABASE_URL=sqlite:///./resources/data/app.db

# ------------------------------------------------------------------
# LLM backend selection
# ------------------------------------------------------------------
# Choose one: local (llama-cpp, offline) | gemini (online) |
#             openai (free routers + Gemini via one interface) | free (keyless)
LLM_PROVIDER=local

# ------------------------------------------------------------------
# Local backend (LLM_PROVIDER=local) — llama-cpp, offline
# ------------------------------------------------------------------
LLM_LOCAL_MODELS_DIR=./resources/models
LLM_LOCAL_MODEL_NAME=qwen3-4b-instruct-gguf
LLM_LOCAL_CONTEXT_WINDOW=4096
LLM_LOCAL_CPU_THREADS=8
LLM_LOCAL_GPU_LAYERS=0
LLM_LOCAL_VERBOSE=false

# ------------------------------------------------------------------
# Gemini backend (LLM_PROVIDER=gemini) — online
# ------------------------------------------------------------------
LLM_GEMINI_API_KEY=
LLM_GEMINI_MODEL=gemini-3.5-flash

# ------------------------------------------------------------------
# OpenAI-compatible backend (LLM_PROVIDER=openai)
# ------------------------------------------------------------------
# - free models: route via the default free router (OpenRouter) with
#   LLM_OPENAI_API_KEY (or LLM_OPENROUTER_API_KEY).
#   See resources/models/free_models.json for model ids.
LLM_OPENAI_API_KEY=
LLM_OPENROUTER_API_KEY=
LLM_OPENAI_BASE_URL=https://openrouter.ai/api/v1
LLM_OPENAI_MODEL=openrouter/free
# - Gemini models through the same provider (model id starting with "gemini-"):
LLM_GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Optional identifiers sent to free routers as HTTP-Referer / X-Title:
# LLM_OPENAI_REFERER=https://github.com/LocalMind
# LLM_OPENAI_TITLE=LocalMind

# ------------------------------------------------------------------
# Free keyless backend (LLM_PROVIDER=free) — no API key at all
# ------------------------------------------------------------------
# LLM_FREE_ENDPOINT picks a public anonymous endpoint from
# resources/models/keyless_models.json; LLM_FREE_MODEL picks the model there;
# LLM_FREE_BASE_URL (optional) overrides the endpoint.
# Keyless tiers sometimes answer with injected ad/budget notices; the free
# provider retries once and then surfaces a clear error instead of showing them.
LLM_FREE_ENDPOINT=pollinations
LLM_FREE_MODEL=openai-fast

# ------------------------------------------------------------------
# System prompt
# ------------------------------------------------------------------
# Points to a markdown file read at import time (fallback prompt when unset).
SYSTEM_PROMPT_PATH=./resources/SYSTEM_PROMPT.md

# ------------------------------------------------------------------
# Tool capabilities
# ------------------------------------------------------------------
# Comma-separated "name=path" folders the file/command tools may use.
# Defaults to a single "workspace=./workspace" folder.
ALLOWED_PLACES=workspace=./workspace
# Set to 1 to let the model propose shell commands (each still needs your approval).
ENABLE_SHELL_TOOLS=0
# Web search backend (currently: bing — keyless RSS).
WEB_SEARCH_PROVIDER=bing
# Automatically turn durable tool findings (fetched pages, search results,
# read files, user answers) into low-importance global facts. 1 = on, 0 = off.
AUTO_MEMORIZE=1